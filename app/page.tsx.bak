                    className="rounded-xl border border-zinc-700 px-8 py-3 text-sm font-semibold text-zinc-300 transition-colors hover:border-cyan-500 hover:text-cyan-400"
                  >
                    View GitHub Repo
                  </a>
                </div>
              </motion.div>
            </section>

            <section id="features" className="mx-auto grid max-w-6xl gap-6 px-6 pb-20 sm:grid-cols-2 lg:grid-cols-3">
