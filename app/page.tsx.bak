      "use client";

      import { useState } from "react";
      import { motion } from "framer-motion";
      import Navbar from "@/components/Navbar";

      export default function HomePage() {
        const [loading, setLoading] = useState(false);

        async function handleCheckout(tier: "starter" | "pro" | "empire") {
          setLoading(true);
          try {
            const res = await fetch(`/api/checkout?tier=${tier}`, { method: "POST" });
            if (!res.ok) {
              throw new Error("Failed to create checkout session");
            }
            const { url } = await res.json();
            window.location.href = url;
          } catch {
            setLoading(false);
          }
        }

        const pricingTiers = [
          {
            key: "starter" as const,
            name: "Starter",
            price: "$497",
            description: "Perfect for solo founders shipping their first revenue-ready template.",
            features: ["1 production site", "Core ClawSite components", "Stripe checkout setup"],
          },
          {
            key: "pro" as const,
            name: "Pro",
            price: "$997",
            description: "For operators who want faster launch velocity and stronger conversion systems.",
            features: ["Everything in Starter", "Launch automation pack", "Priority support + copy refresh"],
            featured: true,
          },
          {
            key: "empire" as const,
            name: "Empire",
            price: "$1,997",
            description: "For agencies and teams scaling multiple offers with one operating system.",
            features: ["Everything in Pro", "Unlimited storefronts", "White-label + handoff assets"],
          },
