name: telegram-bot-v2
version: "2.0"
description: Telegram Bot connector using the BotFather token.

config:
  bot_token: ${TELEGRAM_BOT_TOKEN}
  webhook_url: ${TELEGRAM_WEBHOOK_URL}

capabilities:
  - send_message
  - send_photo
  - send_document
  - receive_update
  - answer_callback_query

actions:
  send_message:
    description: Send a text message to a Telegram chat.
    input:
      chat_id:
        type: string
        description: Telegram chat ID or @username
      text:
        type: string
      parse_mode:
        type: string
        enum: [Markdown, HTML]
        required: false
    output:
      message_id:
        type: integer

  send_photo:
    description: Send a photo to a Telegram chat.
    input:
      chat_id:
        type: string
      photo_url:
        type: string
      caption:
        type: string
        required: false
    output:
      message_id:
        type: integer

  send_document:
    description: Send a document/file to a Telegram chat.
    input:
      chat_id:
        type: string
      document_url:
        type: string
      filename:
        type: string
        required: false
    output:
      message_id:
        type: integer

  receive_update:
    description: Handle an incoming Telegram update (webhook).
    trigger: webhook
    output:
      update_id:
        type: integer
      message:
        type: object

  answer_callback_query:
    description: Acknowledge a callback query from an inline keyboard.
    input:
      callback_query_id:
        type: string
      text:
        type: string
        required: false

error_handling:
  retry_on:
    - too_many_requests
    - network_error
  max_retries: 5
  backoff_seconds: 2
