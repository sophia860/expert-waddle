name: google-workspace-v2
version: "2.0"
description: Google Workspace connector (Gmail, Calendar, Drive) via OAuth 2.0.

config:
  client_id: ${GOOGLE_CLIENT_ID}
  client_secret: ${GOOGLE_CLIENT_SECRET}
  refresh_token: ${GOOGLE_REFRESH_TOKEN}
  scopes:
    - https://www.googleapis.com/auth/gmail.send
    - https://www.googleapis.com/auth/calendar
    - https://www.googleapis.com/auth/drive.file

capabilities:
  - send_email
  - create_calendar_event
  - list_calendar_events
  - upload_drive_file
  - list_drive_files

actions:
  send_email:
    description: Send an email via Gmail.
    input:
      to:
        type: string
      subject:
        type: string
      body_html:
        type: string
      cc:
        type: string
        required: false
    output:
      message_id:
        type: string

  create_calendar_event:
    description: Create a Google Calendar event.
    input:
      summary:
        type: string
      start_datetime:
        type: string
        description: ISO 8601 datetime (e.g. 2026-05-01T10:00:00Z)
      end_datetime:
        type: string
      attendees:
        type: array
        items:
          type: string
        required: false
      description:
        type: string
        required: false
    output:
      event_id:
        type: string
      html_link:
        type: string

  list_calendar_events:
    description: List upcoming Google Calendar events.
    input:
      max_results:
        type: integer
        default: 10
      time_min:
        type: string
        required: false
    output:
      events:
        type: array

  upload_drive_file:
    description: Upload a file to Google Drive.
    input:
      file_path:
        type: string
      mime_type:
        type: string
      parent_folder_id:
        type: string
        required: false
    output:
      file_id:
        type: string
      web_view_link:
        type: string

  list_drive_files:
    description: List files in Google Drive.
    input:
      query:
        type: string
        required: false
      max_results:
        type: integer
        default: 20
    output:
      files:
        type: array

error_handling:
  retry_on:
    - rate_limit_exceeded
    - backend_error
  max_retries: 3
  backoff_seconds: 5
